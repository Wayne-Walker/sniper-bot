# sol-scanner reads the REPO ROOT .env (../.env), shared with the Python bots.
# This file documents only the keys this scanner uses.

# ── Helius (free tier is sufficient — uses logsSubscribe, not Atlas) ──
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key_here
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_key_here

# ── Maturity: how long a token must SURVIVE before it is scored ──────
SCAN_MATURITY_MINUTES=15     # nothing is alerted before this
SCAN_RECHECK_SECONDS=60      # sweep interval
SCAN_MAX_PENDING=5000        # watchlist cap

# ── Gates applied at maturity ────────────────────────────────────────
SCAN_MAX_RISK_SCORE=20       # RugCheck score_normalised — LOW = SAFE
SCAN_MIN_LP_LOCKED_PCT=50    # LP burned/locked %
SCAN_MIN_LIQUIDITY_USD=15000
SCAN_MAX_TOP_HOLDER_PCT=15   # single largest non-LP holder
SCAN_MAX_TOP10_HOLDER_PCT=40
SCAN_MIN_HOLDERS=75
SCAN_MAX_INSIDER_PCT=10      # combined insider-flagged supply

# ── Alerts ───────────────────────────────────────────────────────────
# Leave false until the journal shows the signal is worth trusting.
SCAN_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: no WALLET_PRIVATE_KEY. This scanner cannot trade by construction.
