# sol-scanner reads the REPO ROOT .env (../.env), shared with the Python bots.
# This file documents only the keys this scanner uses.
#
# NO API KEY REQUIRED. The scanner runs entirely on Jupiter's free public
# mirror (lite-api.jup.ag): 60 req/min, no key, no account. We poll once a
# minute. There is no Helius dependency and no wallet — it cannot trade.

SCAN_POLL_SECONDS=60         # 1 req/min of a 60/min allowance
JUP_WINDOW=1h                # organic-score ranking window (5m/1h/6h/24h)
JUP_LIMIT=100                # candidates per poll

# ── Survival window ──────────────────────────────────────────────────
SCAN_MIN_AGE_MINUTES=15      # younger than this has proven nothing
SCAN_MAX_AGE_MINUTES=180     # older than this and we are not early

# ── Gates ────────────────────────────────────────────────────────────
SCAN_MIN_LIQUIDITY_USD=15000
SCAN_MIN_HOLDERS=75
SCAN_MAX_TOP_HOLDERS_PCT=25
SCAN_MIN_ORGANIC_SCORE=40    # Jupiter's own organic-activity score
SCAN_MIN_LIQ_CHANGE_PCT=-25  # 1h liquidity change floor — catches LP draining
SCAN_MAX_DEV_MINTS=50        # deployer's lifetime mint count — catches factories
SCAN_MIN_LP_LOCKED_PCT=0     # 0 = skip the extra RugCheck call

# ── Alerts ───────────────────────────────────────────────────────────
SCAN_ALERTS_ENABLED=false    # leave false until the journal earns trust
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
